{
  "name": "imagine-writes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib eslint.config.mjs next.config.ts",
    "typecheck": "tsc --noEmit",
    "lint:contract": "node scripts/run-python-tool.mjs genvm-lint check contracts/imagine_writes.py --json",
    "typecheck:contract": "node scripts/run-python-tool.mjs genvm-lint typecheck contracts/imagine_writes.py --json",
    "test:contract": "node scripts/run-python-tool.mjs pytest tests/direct -q",
    "test:integration": "node scripts/run-python-tool.mjs gltest tests/integration/test_imagine_writes_studionet.py -v -s --network studionet",
    "schema": "node scripts/run-python-tool.mjs genvm-lint schema contracts/imagine_writes.py --output abi/imagine_writes.json",
    "verify": "npm run lint:contract && npm run typecheck:contract && npm run test:contract && npm run lint && npm run typecheck && npm run build",
    "network:studionet": "genlayer network set studionet",
    "account": "genlayer account show",
    "deploy:studionet": "genlayer deploy --contract contracts/imagine_writes.py"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.17"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "genlayer": "0.39.2",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  }
}
